{
  "version": "1.0",
  "mode": "dryrun",

  "_comment_mode": "dryrun = logs what would be suppressed but loads everything. active = actually suppresses. disabled = off.",

  "never_suppress": [
    "woocommerce",
    "woocommerce-payments",
    "woocommerce-gateway-*",
    "woocommerce-shipping-*",
    "woocommerce-subscriptions",
    "woocommerce-product-bundles",
    "woocommerce-gift-cards",
    "woocommerce-points-and-rewards",
    "automatewoo",
    "stripe-for-woocommerce",
    "checkout-plugins-stripe-woo",
    "payment-gateway-stripe-and-woocommerce-integration",
    "woocommerce-square",
    "klarna-*",
    "afterpay-gateway-for-woocommerce",
    "rvvup",
    "viva-com-smart-for-woocommerce",
    "wordfence",
    "sucuri-scanner",
    "better-wp-security",
    "really-simple-ssl",
    "real-cookie-banner",
    "complianz-gdpr",
    "cookie-notice",
    "cookiebot",
    "wp-rocket",
    "litespeed-cache",
